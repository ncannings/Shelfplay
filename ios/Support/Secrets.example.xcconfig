// Copy to Secrets.xcconfig (gitignored) and fill in.

// Your Apple developer team ID (Xcode > Settings > Accounts).
DEVELOPMENT_TEAM =

// A bundle ID you own. Enable the MusicKit app service for it at
// developer.apple.com > Identifiers so Apple Music lookups work.
SHELFPLAY_BUNDLE_ID = com.example.shelfplay

// Spotify app Client ID (public). Add shelfplay://callback as a Redirect URI
// in the Spotify developer dashboard. Leave blank to fetch from
// https://SHELFPLAY_API_HOST/api/config instead.
SPOTIFY_CLIENT_ID =

// Host of your ShelfPlay Cloudflare Worker, without https:// (used for
// family library sync and as a Client ID fallback). e.g. shelfplay.stream
SHELFPLAY_API_HOST =
